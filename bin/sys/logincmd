#!/usr/bin/env bash
set -euo pipefail

usage() {
    cat <<'EOF'
usage: logincmd <greetd|greetd-vts|getty|status> [--force]

Switch the tty1 login provider.

commands:
  greetd      install the greetd config and enable greetd on tty1
  greetd-vts  enable greetd on tty1, tty2, and tty3
  getty       disable greetd and restore getty on tty1, tty2, and tty3
  status      show current systemd state

options:
  --force  allow switching while running from a managed tty
EOF
}

error() {
    echo "error: $1" >&2
    exit 1
}

require_command() {
    command -v "$1" >/dev/null 2>&1 || error "$1 is not installed"
}

current_tty() {
    tty 2>/dev/null || true
}

require_not_tty1() {
    if [[ "${force}" == true ]]; then
        return
    fi

    if [[ "$(current_tty)" == "/dev/tty1" ]]; then
        error "switch to tty2 first with Ctrl+Alt+F2, or pass --force"
    fi
}

require_not_managed_tty() {
    if [[ "${force}" == true ]]; then
        return
    fi

    case "$(current_tty)" in
        /dev/tty1|/dev/tty2|/dev/tty3)
            error "switch to tty4 first with Ctrl+Alt+F4, or pass --force"
            ;;
    esac
}

require_root() {
    if [[ "${EUID}" -eq 0 ]]; then
        return
    fi

    exec sudo -- "$0" "$@"
}

install_shared_config() {
    require_command setvtrgb
    require_command tuigreet

    local root tuigreet_config_src vtrgb_src
    root=$(repo_root)
    tuigreet_config_src="${root}/sys/etc/tuigreet/config.toml"
    vtrgb_src="${root}/sys/etc/vtrgb"
    [[ -f "${tuigreet_config_src}" ]] || error "missing ${tuigreet_config_src}"
    [[ -f "${vtrgb_src}" ]] || error "missing ${vtrgb_src}"

    install -d -m 0755 /etc/tuigreet
    install -m 0644 "${tuigreet_config_src}" /etc/tuigreet/config.toml

    install -m 0644 "${vtrgb_src}" /etc/vtrgb
    setvtrgb /etc/vtrgb
}

repo_root() {
    local script_path
    script_path=$(readlink -f "${BASH_SOURCE[0]}")
    dirname "$(dirname "$(dirname "${script_path}")")"
}

enable_greetd() {
    require_not_tty1
    require_command greetd

    local root greetd_config_src
    root=$(repo_root)
    greetd_config_src="${root}/sys/etc/greetd/config.toml"
    [[ -f "${greetd_config_src}" ]] || error "missing ${greetd_config_src}"

    install_shared_config
    install -d -m 0755 /etc/greetd
    install -m 0644 "${greetd_config_src}" /etc/greetd/config.toml

    systemctl stop greetd@1.service greetd@2.service greetd@3.service || true
    systemctl disable greetd@1.service greetd@2.service greetd@3.service || true
    systemctl unmask getty@tty2.service getty@tty3.service || true
    systemctl disable getty@tty1.service
    systemctl enable greetd.service
    systemctl restart greetd.service
}

enable_greetd_vts() {
    require_not_managed_tty
    require_command greetd

    local root service_src tty
    root=$(repo_root)
    service_src="${root}/sys/etc/systemd/system/greetd@.service"
    [[ -f "${service_src}" ]] || error "missing ${service_src}"

    install_shared_config
    install -d -m 0755 /etc/greetd
    for tty in 1 2 3; do
        install -m 0644 "${root}/sys/etc/greetd/tty${tty}.toml" "/etc/greetd/tty${tty}.toml"
    done

    install -d -m 0755 /etc/systemd/system
    install -m 0644 "${service_src}" /etc/systemd/system/greetd@.service

    systemctl daemon-reload
    systemctl disable greetd.service || true
    systemctl disable getty@tty1.service getty@tty2.service getty@tty3.service
    systemctl mask getty@tty1.service getty@tty2.service getty@tty3.service
    systemctl enable greetd@1.service greetd@2.service greetd@3.service
    systemctl restart greetd@1.service greetd@2.service greetd@3.service
}

enable_getty() {
    systemctl stop greetd.service || true
    systemctl stop greetd@1.service greetd@2.service greetd@3.service || true
    systemctl disable greetd.service
    systemctl disable greetd@1.service greetd@2.service greetd@3.service || true
    systemctl unmask getty@tty1.service getty@tty2.service getty@tty3.service
    systemctl enable getty@tty1.service getty@tty2.service getty@tty3.service
    systemctl restart getty@tty1.service getty@tty2.service getty@tty3.service
}

show_status() {
    systemctl --no-pager status \
        display-manager.service \
        greetd.service \
        greetd@1.service \
        greetd@2.service \
        greetd@3.service \
        getty@tty1.service \
        getty@tty2.service \
        getty@tty3.service || true
}

force=false
action=
original_args=("$@")

while [[ "$#" -gt 0 ]]; do
    case "$1" in
        greetd|greetd-vts|getty|status)
            [[ -z "${action}" ]] || error "only one command can be used"
            action="$1"
            ;;
        --force)
            force=true
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        *)
            usage >&2
            exit 1
            ;;
    esac
    shift
done

[[ -n "${action}" ]] || {
    usage >&2
    exit 1
}

if [[ "${action}" == status ]]; then
    show_status
    exit 0
fi

if [[ "${action}" == greetd ]]; then
    require_not_tty1
elif [[ "${action}" == greetd-vts ]]; then
    require_not_managed_tty
fi

require_root "${original_args[@]}"

case "${action}" in
    greetd) enable_greetd ;;
    greetd-vts) enable_greetd_vts ;;
    getty) enable_getty ;;
esac
